<Window x:Class="QuickJack.App.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuickJack.App.Views"
        Title="QuickJack"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Width="56" Height="56"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <views:EqualsToVisibilityConverter x:Key="Eq" />
        <views:BoolToVisibilityConverter x:Key="Bool" />
        <views:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        <views:NegateConverter x:Key="Not" />
    </Window.Resources>

    <Grid>
        <!-- ===== collapsed orb ===== -->
        <Border x:Name="Orb"
                Width="48" Height="48"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="24"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Accent}"
                BorderThickness="2"
                Cursor="Hand"
                ToolTip="QuickJack — click to open, drag to move">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <TextBlock Text="⚡" FontSize="22"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource Warn}" />
        </Border>

        <!-- ===== expanded palette ===== -->
        <Border x:Name="Palette"
                Visibility="Collapsed"
                CornerRadius="12"
                Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.6" Color="Black" />
            </Border.Effect>

            <Grid Margin="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- search bar (doubles as the drag handle) -->
                <Border x:Name="DragHandle" Grid.Row="0" Padding="14,10" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="⚡" FontSize="15" Margin="0,0,10,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource Warn}" />

                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox"
                                     Style="{StaticResource SearchBox}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Search commands…"
                                       Foreground="{StaticResource TextFaint}"
                                       FontSize="15" IsHitTestVisible="False"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="2" Content="✕" Style="{StaticResource IconButton}"
                                Click="OnCollapseClick" ToolTip="Close (Esc)" />
                    </Grid>
                </Border>

                <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom"
                           Fill="{StaticResource Border}" />

                <!-- ===== browsing ===== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Browsing}">
                    <ListBox x:Name="CommandList"
                             ItemsSource="{Binding Items}"
                             SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="OnListDoubleClick"
                             PreviewMouseRightButtonDown="OnListRightButtonDown">
                        <!-- Acts on the selected row, which the right-click handler sets first. -->
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Run" Command="{Binding ActivateCommand}" />
                                <Separator />
                                <MenuItem Header="Pin for no-prompt admin…"
                                          Command="{Binding PinCommand}"
                                          Visibility="{Binding Selected.CanPin,
                                              Converter={StaticResource Bool}}" />
                                <MenuItem Header="Unpin"
                                          Command="{Binding UnpinCommand}"
                                          Visibility="{Binding Selected.IsPinned,
                                              Converter={StaticResource Bool}}" />
                                <Separator />
                                <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="6,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" CornerRadius="7" Padding="8,7"
                                                    Background="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{StaticResource SurfaceRaised}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background"
                                                            Value="{StaticResource AccentDim}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5"
                                                   Foreground="{StaticResource Text}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                   Foreground="{StaticResource TextFaint}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Description,
                                                       Converter={StaticResource NotEmpty}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Border Background="#33FACC15" CornerRadius="4"
                                                Padding="6,2" Margin="4,0,0,0"
                                                ToolTip="Registered through the API and not approved yet"
                                                Visibility="{Binding NeedsApproval,
                                                    Converter={StaticResource Bool}}">
                                            <TextBlock Text="new" FontSize="10"
                                                       Foreground="{StaticResource Warn}" />
                                        </Border>
                                        <Border Background="#33F87171" CornerRadius="4"
                                                Padding="6,2" Margin="4,0,0,0"
                                                ToolTip="{Binding BadgeTooltip}"
                                                Visibility="{Binding Badge,
                                                    Converter={StaticResource NotEmpty}}">
                                            <TextBlock Text="{Binding Badge}" FontSize="10"
                                                       Foreground="{StaticResource Danger}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource Bool}}">
                        <TextBlock Text="No commands yet" Foreground="{StaticResource TextMuted}"
                                   FontSize="13" HorizontalAlignment="Center" />
                        <TextBlock Text="Register one through the API, or add it in settings."
                                   Foreground="{StaticResource TextFaint}" FontSize="11.5"
                                   Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ===== parameters ===== -->
                <ScrollViewer Grid.Row="1" Padding="14,10" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Mode, Converter={StaticResource Eq},
                                  ConverterParameter=CollectingParameters}">
                    <StackPanel>
                        <TextBlock Text="{Binding Pending.Name}" FontSize="14"
                                   Foreground="{StaticResource Text}" Margin="0,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource FieldBox}"
                                                 Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{Binding Hint}" FontSize="10.5"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   Foreground="{StaticResource TextFaint}"
                                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                                   Visibility="{Binding Hint,
                                                       Converter={StaticResource NotEmpty}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="Run" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SubmitParametersCommand}" />
                            <Button Content="Back" Style="{StaticResource IconButton}"
                                    Command="{Binding BackCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== confirm / approve ===== -->
                <StackPanel Grid.Row="1" Margin="16,14" VerticalAlignment="Center"
                            Visibility="{Binding Mode, Converter={StaticResource Eq},
                                ConverterParameter=Confirming}">
                    <TextBlock Text="{Binding Pending.Name}" FontSize="15"
                               Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Pending.SourceText}" FontSize="11.5"
                               Foreground="{StaticResource TextFaint}" Margin="0,4,0,0" />
                    <Border Background="{StaticResource SurfaceRaised}" CornerRadius="7"
                            Padding="10" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Pending.Command.Script}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                                   MaxHeight="140" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="{Binding ConfirmLabel}" Style="{StaticResource PrimaryButton}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                                Command="{Binding ConfirmCommand}" />
                        <Button Content="Not now" Style="{StaticResource IconButton}"
                                Command="{Binding BackCommand}" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== output ===== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter=Output}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CurrentRun.CommandName}" FontSize="13"
                                       Foreground="{StaticResource Text}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CurrentRun.StatusText}" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" />
                                <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextFaint}" />
                                <TextBlock Text="{Binding CurrentRun.Elapsed}" FontSize="11"
                                           Foreground="{StaticResource TextFaint}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Stop" Style="{StaticResource IconButton}"
                                    Command="{Binding CurrentRun.CancelCommand}" />
                            <Button Content="Copy" Style="{StaticResource IconButton}"
                                    Command="{Binding CurrentRun.CopyCommand}" />
                            <Button Content="Back" Style="{StaticResource IconButton}"
                                    Command="{Binding BackCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#FF15171C" CornerRadius="8" Margin="10,0,10,10">
                        <ScrollViewer x:Name="OutputScroller" Padding="10,8"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CurrentRun.Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsInfo}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{StaticResource TextFaint}" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ===== footer ===== -->
                <Border Grid.Row="2" Padding="14,8" BorderThickness="0,1,0,0"
                        BorderBrush="{StaticResource Border}">
                    <Grid>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                                   Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource NotEmpty}}" />
                        <TextBlock FontSize="11" Foreground="{StaticResource TextFaint}"
                                   HorizontalAlignment="Right"
                                   Text="↑↓ select · ⏎ run · Ctrl+P pin · Esc close" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
